load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift.bzl", "swift_library", "swift_interop_hint", "swift_test")
load("@rules_apple//apple:macos.bzl", "macos_application")

# --- Scripts ---
# Setup:   bazel run //:setup
# Package: bazel run //:package -- 0.3.0

sh_binary(
    name = "setup",
    srcs = ["scripts/setup.sh"],
)

sh_binary(
    name = "package",
    srcs = ["scripts/package.sh"],
    data = ["scripts/setup.sh"],
)

# Prebuilt dependencies are fetched by Bazel repo rules in deps.bzl:
#   @sherpa_onnx  — sherpa-onnx + onnxruntime shared libraries
#   @sparkle      — Sparkle.framework (auto-update)
#   @silero_vad   — Silero VAD model (bundled in app)

# --- CSherpaOnnx: C wrapper for sherpa-onnx API ---

swift_interop_hint(
    name = "CSherpaOnnx_interop",
    module_name = "CSherpaOnnx",
)

cc_library(
    name = "CSherpaOnnx",
    hdrs = ["Sources/CSherpaOnnx/include/c-api.h"],
    srcs = ["Sources/CSherpaOnnx/shim.c"],
    includes = ["Sources/CSherpaOnnx/include"],
    aspect_hints = [":CSherpaOnnx_interop"],
    deps = [
        "@sherpa_onnx//:sherpaonnx",
        "@sherpa_onnx//:onnxruntime",
    ],
)

# --- Chirp Swift library (no @main, testable) ---

swift_library(
    name = "ChirpLib",
    srcs = glob(
        ["Sources/Chirp/*.swift"],
        exclude = ["Sources/Chirp/Main.swift"],
    ),
    module_name = "Chirp",
    deps = [":CSherpaOnnx"],
    copts = [
        "-swift-version", "6",
    ],
)

# --- App entry point (@main) ---

swift_library(
    name = "ChirpMain",
    srcs = ["Sources/Chirp/Main.swift"],
    module_name = "ChirpMain",
    deps = [
        ":ChirpLib",
        "@sparkle//:Sparkle",
    ],
    copts = [
        "-swift-version", "6",
    ],
)

# --- macOS application bundle ---
# Build:  bazel build //:Chirp
# Run:    bazel run //:Chirp
# Bundle: bazel-bin/Chirp.zip (contains Chirp.app)

macos_application(
    name = "Chirp",
    bundle_id = "com.chirp.app",
    minimum_os_version = "26.0",
    infoplists = ["Sources/Chirp/Info.plist"],
    entitlements = "Sources/Chirp/Chirp.entitlements",
    resources = [
        "Sources/Chirp/AppIcon.icns",
        "THIRD_PARTY_NOTICES",
        "@silero_vad//file",
    ],
    deps = [":ChirpMain"],
)

# --- Tests ---
# Run: bazel test //:ChirpTests

swift_test(
    name = "ChirpTests",
    srcs = glob(["Tests/ChirpTests/*.swift"]),
    deps = [":ChirpLib"],
    copts = [
        "-swift-version", "6",
    ],
)
