load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift.bzl", "swift_library", "swift_interop_hint", "swift_test")
load("@rules_apple//apple:macos.bzl", "macos_application")

# --- Scripts ---
# Package: bazel run //:package -- 0.3.0

sh_binary(
    name = "package",
    srcs = ["scripts/package.sh"],
    data = ["scripts/setup.sh"],
)

# --- Prebuilt sherpa-onnx dynamic libraries (downloaded by scripts/setup.sh) ---

cc_import(
    name = "libsherpaonnx",
    shared_library = "Frameworks/lib/libsherpa-onnx-c-api.dylib",
)

cc_import(
    name = "libonnxruntime",
    shared_library = "Frameworks/lib/libonnxruntime.1.23.2.dylib",
)

# --- CSherpaOnnx: C wrapper for sherpa-onnx API ---

swift_interop_hint(
    name = "CSherpaOnnx_interop",
    module_name = "CSherpaOnnx",
)

cc_library(
    name = "CSherpaOnnx",
    hdrs = ["Sources/CSherpaOnnx/include/c-api.h"],
    srcs = ["Sources/CSherpaOnnx/shim.c"],
    includes = ["Sources/CSherpaOnnx/include"],
    aspect_hints = [":CSherpaOnnx_interop"],
    deps = [
        ":libsherpaonnx",
        ":libonnxruntime",
    ],
)

# --- Chirp Swift library (no @main, testable) ---

swift_library(
    name = "ChirpLib",
    srcs = glob(
        ["Sources/Chirp/*.swift"],
        exclude = ["Sources/Chirp/Main.swift"],
    ),
    module_name = "Chirp",
    deps = [":CSherpaOnnx"],
    copts = [
        "-swift-version", "6",
    ],
)

# --- App entry point (@main) ---

swift_library(
    name = "ChirpMain",
    srcs = ["Sources/Chirp/Main.swift"],
    module_name = "ChirpMain",
    deps = [":ChirpLib"],
    copts = [
        "-swift-version", "6",
        "-Xfrontend", "-DBAZEL_BUILD",
    ],
)

# --- macOS application bundle ---
# Build:  bazel build //:Chirp
# Run:    bazel run //:Chirp
# Bundle: bazel-bin/Chirp.zip (contains Chirp.app)

macos_application(
    name = "Chirp",
    bundle_id = "com.chirp.app",
    minimum_os_version = "26.0",
    infoplists = ["Sources/Chirp/Info.plist"],
    entitlements = "Sources/Chirp/Chirp.entitlements",
    resources = ["Sources/Chirp/AppIcon.icns"],
    deps = [":ChirpMain"],
)

# --- Tests ---
# Run: bazel test //:ChirpTests

swift_test(
    name = "ChirpTests",
    srcs = glob(["Tests/ChirpTests/*.swift"]),
    deps = [":ChirpLib"],
    copts = [
        "-swift-version", "6",
    ],
)
