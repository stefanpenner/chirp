load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift.bzl", "swift_library", "swift_interop_hint", "swift_test")
load("@rules_apple//apple:macos.bzl", "macos_application")

# --- Scripts ---
# Setup:   bazel run //:setup
# Package: bazel run //:package -- 0.3.0

sh_binary(
    name = "setup",
    srcs = ["scripts/setup.sh"],
)

sh_binary(
    name = "package",
    srcs = ["scripts/package.sh"],
    data = ["scripts/setup.sh"],
)

sh_test(
    name = "package_test",
    srcs = ["scripts/package_test.sh"],
    data = ["scripts/package.sh"],
)

sh_test(
    name = "update_appcast_test",
    srcs = ["scripts/update_appcast_test.sh"],
    data = ["scripts/update-appcast.sh"],
)

# Prebuilt dependencies are fetched by Bazel repo rules in deps.bzl:
#   @sherpa_onnx  — sherpa-onnx + onnxruntime shared libraries + CSherpaOnnx Swift module
#   @sparkle      — Sparkle.framework (auto-update)
#   @silero_vad   — Silero VAD model (bundled in app)

# --- COnnxRuntime C module (vendored ORT headers) ---

swift_interop_hint(
    name = "COnnxRuntime_interop",
    module_name = "COnnxRuntime",
)

cc_library(
    name = "COnnxRuntime",
    hdrs = glob(["Sources/COnnxRuntime/include/*.h"]),
    strip_include_prefix = "Sources/COnnxRuntime/include",
    deps = ["@sherpa_onnx//:onnxruntime"],
    aspect_hints = [":COnnxRuntime_interop"],
)

# --- Chirp Swift library (no @main, testable) ---

swift_library(
    name = "ChirpLib",
    srcs = glob(
        ["Sources/Chirp/*.swift", "Sources/Chirp/Providers/*.swift"],
        exclude = ["Sources/Chirp/Main.swift"],
    ),
    module_name = "Chirp",
    deps = [
        "@sherpa_onnx//:CSherpaOnnx",
        ":COnnxRuntime",
    ],
    copts = [
        "-swift-version", "6",
    ],
)

# --- App entry point (@main) ---

swift_library(
    name = "ChirpMain",
    srcs = ["Sources/Chirp/Main.swift"],
    module_name = "ChirpMain",
    deps = [
        ":ChirpLib",
        "@sparkle//:Sparkle",
    ],
    copts = [
        "-swift-version", "6",
    ],
)

# --- macOS application bundle ---
# Build:  bazel build //:Chirp
# Run:    bazel run //:Chirp
# Bundle: bazel-bin/Chirp.zip (contains Chirp.app)

macos_application(
    name = "Chirp",
    bundle_id = "com.chirp.app",
    minimum_os_version = "15.0",
    infoplists = ["Sources/Chirp/Info.plist"],
    entitlements = "Sources/Chirp/Chirp.entitlements",
    resources = [
        "Sources/Chirp/AppIcon.icns",
        "THIRD_PARTY_NOTICES",
        "@silero_vad//file",
    ],
    deps = [":ChirpMain"],
)

