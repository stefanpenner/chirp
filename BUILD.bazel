# Always-on real-audio ASR smoke (hello_world.wav). Skips if model missing.
# bazel test //:FixtureASRTests --test_output=errors
swift_test(
    name = "FixtureASRTests",
    srcs = [
        "Tests/ChirpTests/FixtureASRTests.swift",
        "Tests/ChirpTests/SpeechAudioGenerator.swift",
        "Tests/ChirpTests/TranscriptionScoring.swift",
    ],
    data = [
        "Tests/ChirpTests/hello_world.wav",
        "@silero_vad//file",
    ],
    deps = [":ChirpLib"],
    copts = ["-swift-version", "6"],
    env_inherit = ["HOME"],
    local = True,
)

swift_test(
    name = "TranscriberIntegrationTests",
    srcs = [
        "Tests/ChirpTests/TranscriberIntegrationTests.swift",
        "Tests/ChirpTests/AudioCorpusPipelineTests.swift",
        "Tests/ChirpTests/SpeechAudioGenerator.swift",
        "Tests/ChirpTests/TranscriptionScoring.swift",
        "Tests/ChirpTests/Mocks.swift",
    ],
    data = [
        "Tests/ChirpTests/hello_world.wav",
        "@silero_vad//file",
    ],
    deps = [":ChirpLib"],
    copts = ["-swift-version", "6"],
    env_inherit = ["HOME"],
    local = True,
    # Requires local Parakeet model + macOS `say`/`afconvert` for corpus generation.
    tags = ["manual"],
)

